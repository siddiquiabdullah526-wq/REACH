# Copy to .env.local for local dev. On Render/Vercel, add these as environment variables.

# --- Basics ---
ORGANIZATION_NAME=Building B Resident Services
DASHBOARD_PASSWORD=pick-a-team-password
SESSION_SECRET=any-long-random-string
# Shows the demo controls (play out calls, simulate texts, network outage, reset). Turn on for the demo.
DEMO_MODE=true
# Your public https URL (no trailing slash). Used by the Retell setup script and Twilio signature checks.
PUBLIC_BASE_URL=https://your-app.onrender.com

# --- Test roster (real, consented numbers only; E.164 format) ---
# If unset, data/contacts.json is used, then data/contacts.example.json (fake 555 numbers).
# CONTACTS_JSON=[{"id":"contact_a","display_name":"Test Resident A","phone":"+19095550101","preferred_language":"en","address":"Unit 2A"}]

# --- Storage ---
# Leave empty to use a JSON file (fine on Render/Railway/local). Required on Vercel (use Supabase or Neon).
DATABASE_URL=
# DATA_FILE=.data/db.json

# --- Retell (voice). Leave empty and calls are simulated. ---
RETELL_API_KEY=
# Optional: the API key with the webhook badge, if different from RETELL_API_KEY
RETELL_WEBHOOK_KEY=
RETELL_FROM_NUMBER=+1XXXXXXXXXX
RETELL_AGENT_ID_EN=
RETELL_AGENT_ID_ES=
# Integer agent version to pin for the demo (so a dashboard edit can't change behavior mid-demo).
# Leave empty while building: Retell then uses the latest version.
RETELL_AGENT_VERSION=
# Only for local curl testing. Never in production.
RETELL_SKIP_SIGNATURE_CHECK=false

# --- Browser "Try the call" button on the landing page ---
# Create a public key in Retell (Settings -> Public keys) and allow your domain + localhost.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
NEXT_PUBLIC_RETELL_WEB_AGENT_ID_EN=
NEXT_PUBLIC_RETELL_WEB_AGENT_ID_ES=

# --- SMS (optional). Leave empty and texts are simulated (labeled on the dashboard). ---
# Real US SMS needs an A2P 10DLC-registered number, which takes days.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Required for JSON posts to /api/webhooks/sms outside demo mode (header: x-reach-secret)
SMS_WEBHOOK_SECRET=
